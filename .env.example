# Existing Multi-Tenant Supabase Project
NEXT_SUPABASE_URL=https://your-project.supabase.co
NEXT_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Multi-tenant isolation UUID from `public.websites.id`
WEBSITE_ID=your-website-uuid

# Security (generate 32-byte base64 key: `openssl rand -base64 32`)
ENCRYPTION_KEY=replace-with-32-byte-base64-secret
CRON_SECRET=replace-with-random-cron-secret

# Gmail SMTP Credentials
GMAIL_USER=your-gmail@gmail.com
GMAIL_APP_PASSWORD="xxxx xxxx xxxx xxxx"
GMAIL_FROM_NAME="LTFRB Slot Helper"

# Optional: Public site URL used in email links
NEXT_PUBLIC_APP_URL=https://your-vercel-app.vercel.app
APP_URL=https://your-vercel-app.vercel.app
